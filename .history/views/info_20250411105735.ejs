<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Send Information to <%= user.name %></title>
  <link rel="stylesheet" href="/css/info.css">
</head>
<body>
  <div class="container">
    <header>
      <h2>Send Information Message to <%= user.name %></h2>
    </header>
    <form action="/admin/information/<%= user._id %>" method="POST">
      <textarea name="information" rows="5" cols="30"><%= user.information %></textarea>
      <button type="submit">Send Information</button>
    </form>
    <footer>
      <a href="/admin">Back to Admin Panel</a>
    </footer>
  </div>
</body>
</html>

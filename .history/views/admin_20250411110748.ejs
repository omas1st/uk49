<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Panel</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <header>
    <h1>Admin Panel</h1>
  </header>
  <section class="search-section">
    <form method="GET" action="/admin">
      <input type="text" name="search" placeholder="Search users by email, name, or username" value="<%= searchQuery %>">
      <button type="submit">Search</button>
    </form>
  </section>
  <section class="table-section">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>WhatsApp</th>
          <th>Username</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(user){ %>
        <tr>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td><%= user.whatsapp %></td>
          <td><%= user.username %></td>
          <td class="action-links">
            <a href="/admin/profile/<%= user._id %>">Profile</a>
            <form action="/admin/delete/<%= user._id %>" method="POST" onsubmit="return confirm('Are you sure to delete this user?')">
              <button type="submit">Delete</button>
            </form>
            <a href="/admin/information/<%= user._id %>">Information</a>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </section>
  <footer>
    <a href="/admin/online">Online Users</a> |
    <a href="/logout">Logout</a>
  </footer>
</body>
</html>

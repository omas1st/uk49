<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard</title>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>Welcome, <%= user.name %>!</h1>
    </header>
    <section class="content">
      <h2>Apex Winning Platform</h2>
      <p>Please press the continue button below to continue.</p>
      <a class="button" href="<%= continueUrl %>">Continue</a>
    </section>
    <section class="info">
      <h3>Information</h3>
      <p><%= user.information ? user.information : 'No messages yet.' %></p>
    </section>
    <section class="message-form">
      <h3>Send a Message</h3>
      <form action="/dashboard/message" method="POST">
        <label for="username">Username:</label>
        <input type="text" id="username" name="username" required>
        <label for="message">Message:</label>
        <textarea id="message" name="message" required></textarea>
        <button type="submit">Send Message</button>
      </form>
    </section>
    <footer>
      <a href="/logout">Logout</a>
    </footer>
  </div>
</body>
</html>

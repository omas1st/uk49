  <div class="main-container">
    <!-- Header Section -->
    <header class="brand-header">
      <h1>APEX WINNING PLATFORM</h1>
      <p>Where Dreams Become Reality</p>
    </header>

    <!-- Welcome Section -->
    <section class="welcome-section">
      <h2>Welcome, <%= user.name %>!</h2>
      <p>We're thrilled to have you as part of our winning community.</p>
    </section>

    <!-- Main Content Section -->
    <section class="main-content">
      <div class="content-card">
        <h3>Your Journey to Success Starts Here</h3>
        <p>Access your personalized winning numbers to win 3 straight numbers and bonus.</p>
        <a class="cta-button" href="<%= continueUrl %>">Continue to Your Account</a>
      </div>
    </section>

    <!-- Testimonial Carousel Section -->
    <section class="testimonial-section">
      <h3>Success Stories from Our Winners</h3>
      <div class="carousel-container">
        <div class="testimonial-carousel">
          <!-- Carousel items will be populated by JavaScript -->
        </div>
      </div>
    </section>

    <!-- Notification Section -->
    <section class="notification-section">
      <div class="section-header">
        <h3><i class="fas fa-bell"></i> Notifications</h3>
      </div>
      <div class="notification-content">
        <p><%= user.information ? user.information : 'No new notifications at this time.' %></p>
      </div>
    </section>

    <!-- Message Section -->
    <section class="message-section">
      <div class="section-header">
        <h3><i class="fas fa-envelope"></i> Send a Message</h3>
      </div>
      <form action="/dashboard/message" method="POST" class="message-form">
        <div class="form-group">
          <label for="username">Username:</label>
          <input type="text" id="username" name="username" required placeholder="Enter recipient's username">
        </div>
        <div class="form-group">
          <label for="message">Message:</label>
          <textarea id="message" name="message" required placeholder="Type your message here..."></textarea>
        </div>
        <button type="submit" class="submit-button">Send Message</button>
      </form>
    </section>

    <!-- Footer Section -->
    <footer class="dashboard-footer">
      <p>&copy; 2023 APEX WINNING PLATFORM. All rights reserved.</p>
      <a href="/logout" class="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </footer>
  </div>

